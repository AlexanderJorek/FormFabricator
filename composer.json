{
    "license": "GPL-3.0-or-later",
    "require": {
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "mpdf/mpdf": "^8.2",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "php-stubs/wordpress-stubs": "^7.0",
        "wp-coding-standards/wpcs": "^3.0",
        "pheromone/phpcs-security-audit": "^2.0",
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "wp-phpunit/wp-phpunit": "^7.1",
        "roots/wordpress-no-content": "^7.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "FabricatorForms\\Tests\\": "tests/",
            "FabricatorForms\\": "includes/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit,perf",
        "test:integration": "phpunit -c phpunit-integration.xml.dist"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
