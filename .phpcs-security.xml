<?xml version="1.0"?>
<ruleset name="FormFabricator-Security">
    <description>
        Security-focused review ruleset for FormFabricator. Separate from .phpcs.xml
        (which enforces day-to-day PSR-1/PSR-2 style) — this one is run manually
        or in CI as part of the security/code-quality review pass described in
        CLAUDE.md, covering the WordPress-Security and CWE-Top-25-oriented parts
        of that protocol. Warnings here are review findings, not style violations.

        Usage: vendor/bin/phpcs --standard=.phpcs-security.xml
    </description>

    <file>forge-forms.php</file>
    <file>uninstall.php</file>
    <file>includes</file>
    <!-- Dev tooling lives outside includes/ and was covered by neither ruleset, so it
         inherited zero linting. build.ps1 strips it from the package; it is still code
         in this repository and should hold the same bar. -->
    <file>languages/compile-mo.php</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>
    <exclude-pattern>includes/PDF/templates/*</exclude-pattern>

    <!-- WordPress.Security.* + WordPress.DB.PreparedSQL* from wp-coding-standards/wpcs:
         nonce verification, output escaping, safe redirects, prepared SQL. Pulled from
         WordPress-Extra individually rather than the whole standard, since the rest of
         WordPress-Extra is stylistic (naming conventions, Yoda conditions, etc.) and out
         of scope for a security-only pass. -->
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.PluginMenuSlug"/>
    <rule ref="WordPress.Security.SafeRedirect"/>
    <!-- Utils\Cast::stringOrDefault() is this plugin's own type guard, NOT a sanitizer: it returns
         its argument only when it is genuinely a string, so a POSTed array can never reach a
         strictly-typed WP sanitizer (sanitize_email() -> strlen(array) and sanitize_hex_color() ->
         preg_match(..., array) are both TypeErrors in PHP 8). It therefore has to sit INSIDE the
         real sanitizer, closest to the superglobal.

         Declaring it here does NOT tell WPCS that the guard sanitizes anything. WPCS inspects only
         the call immediately wrapping the superglobal; when that is an unrecognised name it stops
         and reports, never looking at the genuine sanitizer outside it. Listing the guard lets the
         sniff WALK PAST it and go on to verify the real WP sanitizer. Coverage is fully retained:
         the guard on its own, with no WP sanitizer around it, is still reported as unsanitized
         (verified empirically against this ruleset).

         The name must stay unique and non-generic. WPCS matches on the bare function/method name
         token and is blind to namespace and class, so a short name such as "str" would also
         silently whitelist any unrelated global function of that name. -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput">
        <properties>
            <property name="customSanitizingFunctions" type="array">
                <element value="stringOrDefault"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>

    <!-- Overwriting a WordPress global is an access-control-adjacent correctness hazard, not a
         style nit: it mutates state other code (and WP core) reads. This caught direct $l10n
         manipulation in Plugin.php that had survived two review passes precisely because no
         configured ruleset covered it. -->
    <rule ref="WordPress.WP.GlobalVariablesOverride"/>

    <!-- Direct database access and filesystem/cURL calls that bypass the WP APIs. Both are
         legitimate in places here (atomic counters, kernel pseudo-files) and both are noisy, so
         they are review material to triage per CLAUDE.md — not a pass/fail gate. Included so a
         NEW bypass has to be looked at and justified rather than sliding in unnoticed. -->
    <rule ref="WordPress.WP.AlternativeFunctions"/>
    <rule ref="WordPress.DB.DirectDatabaseQuery"/>

    <!-- error_log()/var_dump() left in shipped code, and @-suppressed errors. -->
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.PHP.NoSilencedErrors"/>

    <!-- Not a security sniff per se, but the table's "WordPress Security Sniffs" row scope
         previously undersold what this ruleset actually covers — WordPress.WP.I18n checks that
         every translatable string is correctly wrapped/escaped, which is unrelated to the checks
         above; it's included here for completeness, not because it substitutes for the manual
         GDPR/i18n-coverage review CLAUDE.md's table also calls for (it can't detect a MISSING
         __() call, only a malformed existing one). -->
    <rule ref="WordPress.WP.I18n"/>

    <!-- pheromone/phpcs-security-audit: generic CWE-oriented dangerous-function checks
         (eval, backticks/shell exec, RFI/include, XSS sinks, weak crypto, SQL string
         building, error-suppression, etc.). Drupal7/Drupal8-specific sniffs excluded —
         this is a WordPress plugin, not Drupal. -->
    <rule ref="Security.BadFunctions"/>
    <rule ref="Security.Misc"/>
</ruleset>
