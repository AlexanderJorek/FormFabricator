<?xml version="1.0"?>
<ruleset name="FormFabricator">
    <description>FormFabricator coding standard</description>

    <file>formfabricator.php</file>
    <file>uninstall.php</file>
    <file>includes</file>
    <!-- Dev tooling lives outside includes/ and was covered by neither ruleset, so it
         inherited zero linting. The release build strips it from the package; it is still code
         in this repository and should hold the same bar. -->
    <file>languages/compile-mo.php</file>
    <file>languages/make-pot.php</file>
    <file>tools</file>
    <file>tests</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>
    <!-- The Node test suite; phpcs would read it as PHP-style JS, as it would assets/. -->
    <exclude-pattern>tests/js/*.js</exclude-pattern>

    <!--
        Every plugin file starts with `defined('ABSPATH') || exit;` before its
        class/constant declarations — this is the standard WordPress plugin
        security guard, not a real side-effect violation. Splitting the guard
        into its own file would go against WP convention, so it's suppressed.
    -->
    <rule ref="PSR2">
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>

    <!-- Line length: warn at 250, hard-error at 300 -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="250"/>
            <property name="absoluteLineLimit" value="300"/>
        </properties>
    </rule>

    <!-- Forbid single-line control structures (if/else/for/foreach/while without braces) -->
    <rule ref="Generic.ControlStructures.InlineControlStructure"/>
</ruleset>
