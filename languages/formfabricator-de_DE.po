msgstr "Anmerkungen, Kästen, Notizen oder Links, die über die Seiten gezeichnet werden"

#: includes/Admin/VerificationPage.php:1508
msgid "what a page draws"
msgstr "was eine Seite zeichnet"

#: includes/Admin/VerificationPage.php:1509
